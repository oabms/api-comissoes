# =============================================================================
# MODELO DE CONFIGURAÇÃO
# =============================================================================
# Copie este arquivo para:
#
#   .env           -> homologação / desenvolvimento (padrão)
#   .env.producao  -> produção (carregado quando APP_ENV=producao)
#
# NENHUM dos dois vai para o Git (ver .gitignore). Só este .env.example é
# versionado — mantenha-o atualizado ao adicionar uma variável nova.
# =============================================================================

# -----------------------------------------------------------------------------
# BANCO DE DADOS (SQL Server) — obrigatórias
# -----------------------------------------------------------------------------
# Homologação: 172.29.7.7  / HBConselhoshml
# Produção:    172.29.7.20 / HBConselhos
DB_SERVER=172.29.7.7
DB_DATABASE=HBConselhoshml
DB_USER=usuario_da_api
DB_PASSWORD=

DB_PORT=1433

# Servidores internos usam certificado autoassinado.
# Em produção, prefira DB_ENCRYPT=true com certificado válido.
DB_ENCRYPT=false
DB_TRUST_CERTIFICATE=true

# Pool e timeouts (opcionais — valores abaixo são os padrões)
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE_TIMEOUT=30000
DB_CONNECT_TIMEOUT=30000
DB_REQUEST_TIMEOUT=30000

# -----------------------------------------------------------------------------
# APLICAÇÃO
# -----------------------------------------------------------------------------
# Portas já em uso pelas outras APIs: 5050 (gerador-titulos), 5200 (anexo-ged),
# 5300 (register-login), 5400 (endereco), 47422 (protocolo).
PORT=5500

NODE_ENV=development
API_NAME=api-comissoes
API_PREFIX=/api

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Lista separada por vírgula. Vazio libera qualquer origem (só em homologação).
CORS_ORIGINS=

# -----------------------------------------------------------------------------
# AUTENTICAÇÃO — ALLOWED_API_KEYS é obrigatória
# -----------------------------------------------------------------------------
# Toda rota de dados (/api/comissoes, /api/pessoas) exige o header `x-api-key`
# com uma destas chaves. Aceita várias separadas por vírgula, o que permite
# rotacionar a chave sem derrubar o consumidor: publica-se a nova, os clientes
# migram, e só então a antiga sai da lista. Sem nenhuma chave a API não sobe.
#
# Gerar uma chave:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ALLOWED_API_KEYS=

# JWT_SECRET só é necessário se alguma rota passar a usar `autenticar` (JWT) em
# vez de `autenticarApiKey`. DEVE ser idêntico ao da api-register-login, que
# assina os tokens (HS256); se divergir, todo token do frontend leva 401.
JWT_SECRET=
JWT_EXPIRES_IN=24h

# -----------------------------------------------------------------------------
# RATE LIMIT (global, por IP)
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# -----------------------------------------------------------------------------
# LOGS
# -----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_MAX_SIZE=20m
LOG_MAX_FILES=30d
